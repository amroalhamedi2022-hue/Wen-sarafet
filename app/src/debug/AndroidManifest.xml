<?xml version="1.0" encoding="utf-8"?>
<!-- Sandbox avoids duplicate private financial notification/SMS collection. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove"/>
    <application>
        <receiver android:name="app.wensarafet.tracker.SmsCaptureReceiver" tools:node="remove"/>
        <service android:name="app.wensarafet.tracker.FinanceNotificationListener" tools:node="remove"/>
        <receiver android:name="app.wensarafet.tracker.BootReceiver" tools:node="remove"/>
    </application>
</manifest>
