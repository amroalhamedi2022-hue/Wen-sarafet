<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- No SMS collection or financial notification listener in a parallel test copy. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"/>
    <application>
        <receiver android:name="app.wensarafet.tracker.SmsCaptureReceiver" tools:node="remove"/>
        <receiver android:name="app.wensarafet.tracker.BootReceiver" tools:node="remove"/>
        <service android:name="app.wensarafet.tracker.FinanceNotificationListener" tools:node="remove"/>
        <activity android:name="app.wensarafet.tracker.WidgetPreviewActivity"
            android:exported="true" android:theme="@style/AppTheme" android:label="Widget Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>