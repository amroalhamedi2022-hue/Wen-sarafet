<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Crystal: the logo is a separate original drawable, not baked into glass. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:layoutDirection="rtl"
    android:background="@android:color/transparent">
    <ImageView android:id="@+id/widget_crystal_glass" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY"
        android:src="@drawable/widget_crystal_quick_base" android:contentDescription="@null"/>
    <ImageView android:id="@+id/widget_background_image" android:layout_width="match_parent"
        android:layout_height="49dp" android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="5dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:scaleType="fitCenter" android:contentDescription="@string/app_name" />
    <TextView android:id="@+id/widget_brand_word" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="34dp" android:textColor="#F5FBFF" android:textSize="8sp"
        android:textStyle="bold" android:shadowColor="#AA07131B"
        android:shadowDy="1" android:shadowRadius="2" android:visibility="gone" />
    <TextView android:id="@+id/widget_choose_contact"
        android:layout_width="34dp" android:layout_height="26dp"
        android:layout_gravity="top|start" android:layout_margin="4dp"
        android:background="@drawable/widget_contact_chip"
        android:gravity="center" android:text="👤" android:textSize="13sp"
        android:contentDescription="اختيار جهة اتصال للتحويل"
        android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
        android:paddingBottom="6dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:textColor="#F9FBFF" android:textSize="10sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:textColor="#C9DCEA" android:textSize="9sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>