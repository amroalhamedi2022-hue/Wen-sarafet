<?xml version="1.0" encoding="utf-8"?>
<!-- Widget view identifiers and click targets remain stable; financial providers are untouched. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_balance_root"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
 android:src="@drawable/widget_crystal_balance_two"
 android:scaleType="fitXY" android:contentDescription="@null"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="horizontal" android:layoutDirection="ltr"
 android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="7dp" android:paddingBottom="7dp">
 
 <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
 android:layout_weight="1" android:orientation="vertical" android:gravity="center"
 android:paddingLeft="2dp" android:paddingRight="2dp">
 <ImageView android:layout_width="match_parent" android:layout_height="0dp"
 android:layout_weight="1" android:layout_gravity="center_horizontal"
 android:paddingLeft="1dp" android:paddingRight="1dp" android:paddingTop="0dp"
 android:paddingBottom="0dp" android:scaleType="fitCenter"
 android:src="@drawable/icon_jawwal_pay_widget_soft" android:alpha="1.0"
 android:scaleX="1.15" android:scaleY="1.15"
 android:contentDescription="Jawwal Pay"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
 android:text="Jawwal Pay" android:textColor="#F8FAFF" android:fontFamily="sans-serif-medium"
 android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
 <TextView android:id="@+id/widget_jawwal_balance" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:gravity="center" android:textColor="#FFFFFFFF" android:textStyle="bold"
 android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>
 <ImageView android:layout_width="1dp" android:layout_height="match_parent"
 android:layout_marginTop="20dp" android:layout_marginBottom="20dp"
 android:background="#37C1D6F4" android:contentDescription="@null"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
 android:layout_weight="1" android:orientation="vertical" android:gravity="center"
 android:paddingLeft="2dp" android:paddingRight="2dp">
 <ImageView android:layout_width="match_parent" android:layout_height="0dp"
 android:layout_weight="1" android:layout_gravity="center_horizontal"
 android:paddingLeft="1dp" android:paddingRight="1dp" android:paddingTop="0dp"
 android:paddingBottom="0dp" android:scaleType="fitCenter"
 android:src="@drawable/icon_bop_widget_soft" android:alpha="1.0"
 android:scaleX="1.15" android:scaleY="1.15"
 android:contentDescription="بنك فلسطين"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
 android:text="بنك فلسطين" android:textColor="#F8FAFF" android:fontFamily="sans-serif-medium"
 android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
 <TextView android:id="@+id/widget_bop_balance" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:gravity="center" android:textColor="#FFFFFFFF" android:textStyle="bold"
 android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout>
 </LinearLayout>
</FrameLayout>